{
    "mcpServers": {
        "zai-visual-understanding": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@z_ai/mcp-server"
            ],
            "env": {
                "Z_AI_API_KEY": "${user_config.zai_api_token}",
                "Z_AI_MODE": "ZHIPU"
            }
        },
        "zai-web-search": {
            "type": "http",
            "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
            "headers": {
                "Authorization": "Bearer ${user_config.zai_api_token}"
            }
        },
        "zai-web-page-reading-mcp": {
            "type": "http",
            "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
            "headers": {
                "Authorization": "Bearer ${user_config.zai_api_token}"
            }
        },
        "zai-open-source-repository-mcp": {
            "type": "http",
            "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
            "headers": {
                "Authorization": "Bearer ${user_config.zai_api_token}"
            }
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "weknora": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "--from",
                "weknora-mcp==1.1.0",
                "weknora-mcp-server"
            ],
            "env": {
                "WEKNORA_BASE_URL": "${user_config.weknora_base_url}",
                "WEKNORA_API_KEY": "${user_config.weknora_api_key}"
            }
        },
        "antd": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@ant-design/cli",
                "mcp"
            ]
        }
    }
}
